<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SkillHub</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        :root {
            --primary-color: #4f46e5;
            --primary-hover: #4338ca;
            --secondary-color: #06b6d4;
            --bg-light: #f8fafc;
        }
        body {
            background-color: var(--bg-light);
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .navbar-brand {
            font-weight: 800;
            letter-spacing: -0.5px;
            color: var(--primary-color) !important;
            font-size: 1.5rem;
        }
        .btn-primary {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
        }
        .btn-primary:hover {
            background-color: var(--primary-hover);
            border-color: var(--primary-hover);
        }
        .badge-capacity {
            font-size: 0.85rem;
            padding: 0.4em 0.7em;
            border-radius: 9999px;
        }
        .card {
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
        }
        footer {
            margin-top: auto;
            background: #ffffff;
            border-top: 1px solid #e2e8f0;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Workshops" asp-action="Index">
                    <i class="bi bi-mortarboard-fill text-primary fs-3"></i>
                    <span>SkillHub</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link fw-semibold" asp-controller="Workshops" asp-action="Index">
                                <i class="bi bi-grid-fill me-1 text-secondary"></i> Catálogo
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var isEmployee = User.IsInRole(UserRoles.Employee) || User.IsInRole(UserRoles.Admin) || User.IsInRole(UserRoles.Administrador);
                            var isParticipant = User.IsInRole(UserRoles.Participant);

                            @if (isParticipant)
                            {
                                <li class="nav-item">
                                    <a class="nav-link fw-semibold" asp-controller="Enrollments" asp-action="Mine">
                                        <i class="bi bi-journal-check me-1 text-success"></i> Mis Inscripciones
                                    </a>
                                </li>
                            }
                            @if (isEmployee)
                            {
                                <li class="nav-item">
                                    <a class="nav-link fw-semibold text-primary" asp-controller="Workshops" asp-action="Create">
                                        <i class="bi bi-plus-circle-fill me-1"></i> Publicar Taller
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link fw-semibold" asp-controller="Reports" asp-action="TopWorkshops">
                                        <i class="bi bi-bar-chart-line-fill me-1 text-info"></i> Reporte Top
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link fw-semibold" asp-controller="Enrollments" asp-action="Import">
                                        <i class="bi bi-file-earmark-excel-fill me-1 text-success"></i> Cargar Excel
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var isEmployee = User.IsInRole(UserRoles.Employee) || User.IsInRole(UserRoles.Admin) || User.IsInRole(UserRoles.Administrador);
                            <li class="nav-item">
                                <span class="badge @(isEmployee ? "bg-warning-subtle text-dark border-warning" : "bg-light text-dark") border px-3 py-2 fw-medium d-flex align-items-center gap-1">
                                    <i class="bi @(isEmployee ? "bi-shield-check text-warning" : "bi-person-circle text-primary")"></i>
                                    @User.Identity.Name @(isEmployee ? "(Administrador)" : "(Participante)")
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm px-3">
                                        <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-primary btn-sm px-3 fw-semibold" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm px-3 fw-semibold text-white" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus-fill me-1"></i> Registrarse
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4 flex-grow-1">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div>@TempData["Success"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>@TempData["Error"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="py-4 text-center text-muted">
        <div class="container">
            <p class="mb-1">&copy; @DateTime.UtcNow.Year SkillHub — Centro de Formación Práctica y Presencial.</p>
            <small class="text-secondary">Desarrollado con Clean Architecture y ASP.NET Core .NET 10.</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
