@model IEnumerable<SkillHub.Application.DTOs.Reports.TopWorkshopReportDto>

@{
    ViewData["Title"] = "Reporte de Talleres Más Concurridos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-bar-chart-fill text-primary me-2"></i> Reporte: Talleres con Más Inscritos
        </h2>
        <p class="text-muted mb-0">Talleres ordenados de mayor a menor según el número de inscripciones activas.</p>
    </div>
</div>

<div class="card shadow-sm border-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-secondary small text-uppercase">
                <tr>
                    <th class="ps-4">Posición</th>
                    <th>Código</th>
                    <th>Taller</th>
                    <th>Instructor</th>
                    <th class="text-center">Inscripciones Activas</th>
                    <th class="text-center">Cupo Total</th>
                    <th class="text-center">Cupos Disponibles</th>
                    <th class="text-end pe-4">Ocupación</th>
                </tr>
            </thead>
            <tbody>
                @{ int rank = 1; }
                @foreach (var item in Model)
                {
                    var percentage = item.Capacity > 0 ? (int)((double)item.ActiveEnrollmentsCount / item.Capacity * 100) : 0;
                    <tr>
                        <td class="ps-4 fw-bold">
                            @if (rank == 1) { <span class="badge bg-warning text-dark"><i class="bi bi-trophy-fill me-1"></i> #1</span> }
                            else if (rank == 2) { <span class="badge bg-secondary"><i class="bi bi-award-fill me-1"></i> #2</span> }
                            else if (rank == 3) { <span class="badge bg-danger text-white"><i class="bi bi-award-fill me-1"></i> #3</span> }
                            else { <span class="text-muted ps-2">#@rank</span> }
                        </td>
                        <td>
                            <span class="badge bg-indigo-subtle text-primary border px-2 py-1 fw-bold">
                                @item.Code
                            </span>
                        </td>
                        <td class="fw-bold text-dark">
                            @item.Title
                        </td>
                        <td class="text-secondary small">
                            @item.InstructorName
                        </td>
                        <td class="text-center fw-bold text-success fs-6">
                            @item.ActiveEnrollmentsCount
                        </td>
                        <td class="text-center text-muted">
                            @item.Capacity
                        </td>
                        <td class="text-center fw-semibold text-primary">
                            @item.AvailableCapacity
                        </td>
                        <td class="text-end pe-4" style="min-width: 140px;">
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height: 8px;">
                                    <div class="progress-bar @(percentage >= 90 ? "bg-danger" : percentage >= 50 ? "bg-warning" : "bg-primary")"
                                         role="progressbar" style="width: @percentage%;"></div>
                                </div>
                                <small class="fw-bold text-secondary">@percentage%</small>
                            </div>
                        </td>
                    </tr>
                    rank++;
                }
            </tbody>
        </table>
    </div>
</div>
