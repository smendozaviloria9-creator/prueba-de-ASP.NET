@{
    ViewData["Title"] = "Registro de Participante";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 p-4 bg-white">
            <div class="text-center mb-4">
                <i class="bi bi-person-plus-fill display-4 text-primary"></i>
                <h3 class="fw-bold mt-2 text-dark">Crear Cuenta</h3>
                <p class="text-muted small">Regístrate como participante para inscribirte en los talleres de SkillHub</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 small shadow-sm">
                    <div asp-validation-summary="All" class="text-danger mb-0"></div>
                </div>
            }

            <form asp-controller="Account" asp-action="Register" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="fullName" class="form-label fw-semibold text-secondary small">Nombre Completo</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                        <input type="text" class="form-control border-start-0" id="fullName" name="fullName" placeholder="Ej. Juan Pérez" required autofocus />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label fw-semibold text-secondary small">Correo Electrónico</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                        <input type="email" class="form-control border-start-0" id="email" name="email" placeholder="juan.perez@correo.com" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label fw-semibold text-secondary small">Contraseña</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                        <input type="password" class="form-control border-start-0" id="password" name="password" placeholder="Mínimo 6 caracteres" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label for="confirmPassword" class="form-label fw-semibold text-secondary small">Confirmar Contraseña</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-shield-check text-muted"></i></span>
                        <input type="password" class="form-control border-start-0" id="confirmPassword" name="confirmPassword" placeholder="Repite tu contraseña" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm mb-3">
                    <i class="bi bi-check-circle-fill me-1"></i> Registrarme e Iniciar
                </button>
            </form>

            <div class="text-center small text-muted border-top pt-3">
                ¿Ya tienes una cuenta?
                <a asp-controller="Account" asp-action="Login" class="text-primary fw-semibold text-decoration-none ms-1">
                    Inicia sesión aquí
                </a>
            </div>
        </div>
    </div>
</div>
