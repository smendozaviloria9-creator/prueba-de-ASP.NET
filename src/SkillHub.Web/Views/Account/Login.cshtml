@{
    ViewData["Title"] = "Iniciar Sesión";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 p-4 bg-white">
            <div class="text-center mb-4">
                <i class="bi bi-person-circle display-4 text-primary"></i>
                <h3 class="fw-bold mt-2 text-dark">Iniciar Sesión</h3>
                <p class="text-muted small">Ingresa con tu cuenta de participante de SkillHub</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 small shadow-sm">
                    <div asp-validation-summary="All" class="text-danger mb-0"></div>
                </div>
            }

            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="email" class="form-label fw-semibold text-secondary small">Correo Electrónico</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                        <input type="email" class="form-control border-start-0" id="email" name="email" placeholder="ejemplo@correo.com" required autofocus />
                    </div>
                </div>

                <div class="mb-4">
                    <label for="password" class="form-label fw-semibold text-secondary small">Contraseña</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                        <input type="password" class="form-control border-start-0" id="password" name="password" placeholder="••••••••" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm mb-3">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Entrar a la Plataforma
                </button>
            </form>

            <div class="text-center small text-muted border-top pt-3">
                ¿Aún no tienes cuenta?
                <a asp-controller="Account" asp-action="Register" class="text-primary fw-semibold text-decoration-none ms-1">
                    Regístrate gratis como participante
                </a>
            </div>

            <div class="accordion mt-4" id="demoAccordion">
                <div class="accordion-item border-0 bg-light rounded">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-light small fw-medium py-2" type="button" data-bs-toggle="collapse" data-bs-target="#demoHelp">
                            <i class="bi bi-key-fill text-warning me-2"></i> Cuentas de prueba pre-cargadas
                        </button>
                    </h2>
                    <div id="demoHelp" class="accordion-collapse collapse" data-bs-parent="#demoAccordion">
                        <div class="accordion-body small text-muted pt-1 pb-3">
                            <div><strong>Participante:</strong> <code>jorge.perez@correo.com</code></div>
                            <div><strong>Contraseña:</strong> <code>Skillhub2026*</code></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
