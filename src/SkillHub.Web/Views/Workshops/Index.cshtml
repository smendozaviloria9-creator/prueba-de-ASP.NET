@model IEnumerable<WorkshopDto>

@{
    ViewData["Title"] = "Talleres Disponibles";
}

<div class="p-4 p-md-5 mb-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%);">
    <div class="container-fluid py-2">
        <h1 class="display-6 fw-bold">Talleres Cortos y Presenciales</h1>
        <p class="col-md-9 fs-5 mb-0 text-white-50">
            Explora nuestra oferta de talleres en fotografía, cocina, oratoria, diseño, música y marketing digital. Cupos limitados con inscripción en tiempo real.
        </p>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 fw-bold mb-0 text-gray-800">Próximos Talleres Disponibles</h2>
        <small class="text-muted">Mostrando solo talleres futuros con cupos calculados en tiempo real</small>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (User.Identity?.IsAuthenticated == true && (User.IsInRole(UserRoles.Employee) || User.IsInRole(UserRoles.Admin) || User.IsInRole(UserRoles.Administrador)))
        {
            <a asp-controller="Workshops" asp-action="Create" class="btn btn-success btn-sm px-3 fw-semibold shadow-sm">
                <i class="bi bi-plus-circle-fill me-1"></i> + Publicar Nuevo Taller
            </a>
        }
        <span class="badge bg-primary px-3 py-2 fs-6">@Model.Count() talleres activos</span>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card p-5 text-center bg-white shadow-sm">
        <i class="bi bi-calendar-x text-muted display-4 mb-3"></i>
        <h5>No hay talleres futuros disponibles en este momento</h5>
        <p class="text-muted">Por favor regresa más tarde para consultar nuevas convocatorias.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var ws in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 bg-white d-flex flex-column">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-indigo-subtle text-indigo border border-indigo-subtle px-2 py-1 fw-bold text-primary">
                                @ws.Code
                            </span>
                            @if (ws.AvailableCapacity > 0)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle badge-capacity fw-semibold">
                                    <i class="bi bi-people-fill me-1"></i> @ws.AvailableCapacity cupos disponibles
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle badge-capacity fw-semibold">
                                    <i class="bi bi-x-circle-fill me-1"></i> Cupo agotado
                                </span>
                            }
                        </div>

                        <h5 class="card-title fw-bold text-dark mb-2">@ws.Title</h5>
                        <p class="card-text text-muted flex-grow-1 small">@ws.Description</p>

                        <div class="bg-light rounded p-2 mb-3 small">
                            <div class="d-flex align-items-center gap-2 mb-1 text-secondary">
                                <i class="bi bi-person-badge text-primary"></i>
                                <span><strong>Instructor:</strong> @ws.InstructorName</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-1 text-secondary">
                                <i class="bi bi-calendar-event text-secondary"></i>
                                <span><strong>Fecha:</strong> @ws.StartDateTime.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 text-secondary">
                                <i class="bi bi-clock text-secondary"></i>
                                <span><strong>Horario:</strong> @ws.StartDateTime.ToString("HH:mm") - @ws.EndDateTime.ToString("HH:mm")</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 text-secondary mt-1">
                                <i class="bi bi-people text-secondary"></i>
                                <span><strong>Inscritos activos:</strong> @ws.ActiveEnrollmentsCount / @ws.Capacity</span>
                            </div>
                        </div>

                        <div class="mt-auto">
                            @if (User.Identity?.IsAuthenticated == true && (User.IsInRole(UserRoles.Employee) || User.IsInRole(UserRoles.Admin) || User.IsInRole(UserRoles.Administrador)))
                            {
                                <div class="d-grid gap-2">
                                    <a asp-controller="Workshops" asp-action="Enrollments" asp-route-id="@ws.Id"
                                       class="btn btn-outline-primary w-100 fw-semibold d-flex align-items-center justify-content-center gap-2 shadow-sm">
                                        <i class="bi bi-people-fill"></i> Ver Participantes (@ws.ActiveEnrollmentsCount)
                                    </a>
                                </div>
                            }
                            else if (User.Identity?.IsAuthenticated == true && User.IsInRole(UserRoles.Participant))
                            {
                                @if (ws.AvailableCapacity > 0)
                                {
                                    <form asp-controller="Workshops" asp-action="Enroll" method="post" class="w-100">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="workshopId" value="@ws.Id" />
                                        <button type="submit" class="btn btn-primary w-100 fw-semibold d-flex align-items-center justify-content-center gap-2">
                                            <i class="bi bi-check-circle"></i> Inscribirme al Taller
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-secondary w-100 fw-semibold" disabled>
                                        <i class="bi bi-dash-circle"></i> Sin cupos disponibles
                                    </button>
                                }
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Index", "Workshops")" class="btn btn-outline-primary w-100 fw-semibold">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Inicia sesión para inscribirte
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
